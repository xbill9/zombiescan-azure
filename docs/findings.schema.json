{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xbill9/zombiescan-azure/blob/main/docs/findings.schema.json",
  "title": "zombiescan findings report",
  "description": "Output of `zombiescan scan --json`. Check schema_version before parsing.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "packs",
    "scan",
    "pricing",
    "totals",
    "findings",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 4,
      "description": "Incremented on any breaking change to this document."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "packs": {
      "type": "array",
      "description": "Packs loaded for this scan. Added in schema_version 2.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "api_version",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "api_version": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "description": "'built-in', or the distribution that provided the pack."
          },
          "homepage": {
            "type": "string"
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "required": [
        "generated",
        "pairs_attempted",
        "complete",
        "subscriptions"
      ],
      "additionalProperties": false,
      "properties": {
        "generated": {
          "type": "string",
          "description": "UTC, ISO 8601."
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "pairs_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "pairs_unavailable": {
          "type": "integer",
          "minimum": 0,
          "description": "Subscription/check pairs skipped because the check's resource provider is not registered on that subscription. Not failures: a subscription that has never used a service has no waste in it. A high count against a low pairs_attempted means most of the catalog did not apply, which is not the same as a clean subscription."
        },
        "complete": {
          "type": "boolean",
          "description": "False when every project/check pair failed. An incomplete scan that found nothing is NOT an all-clear."
        },
        "principal": {
          "type": [
            "string",
            "null"
          ],
          "description": "Who the scan ran as: the user or service principal the Azure CLI is signed in as."
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every subscription the scan covered. A finding's subscription means nothing without it."
        }
      }
    },
    "pricing": {
      "type": "object",
      "required": [
        "generated",
        "basis",
        "excludes"
      ],
      "additionalProperties": false,
      "properties": {
        "generated": {
          "type": [
            "string",
            "null"
          ],
          "description": "When the bundled price table was built. Without it the report is not auditable."
        },
        "basis": {
          "type": "string",
          "description": "Where the prices came from. Azure Retail Prices API, pay-as-you-go USD list prices."
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "monthly_cost",
        "annual_cost",
        "finding_count",
        "by_check"
      ],
      "additionalProperties": false,
      "properties": {
        "monthly_cost": {
          "type": "number",
          "minimum": 0
        },
        "annual_cost": {
          "type": "number",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "by_check": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "count",
              "monthly_cost"
            ],
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "monthly_cost": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "resource_id",
          "resource_type",
          "location",
          "reason",
          "monthly_cost",
          "approximate_cost",
          "remediation",
          "details",
          "subscription",
          "resource_group",
          "arm_id"
        ],
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          },
          "resource_type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "monthly_cost": {
            "type": "number",
            "minimum": 0
          },
          "approximate_cost": {
            "type": "boolean",
            "description": "True when the figure is an estimate or an upper bound. details.note says why."
          },
          "remediation": {
            "type": "string",
            "description": "An `az` command. Generated, never executed. It always names its subscription and its resource group, and carries --yes only where the command would otherwise prompt."
          },
          "details": {
            "type": "object"
          },
          "location": {
            "type": "string",
            "description": "An Azure region as ARM spells it (eastus), or \"global\" for a resource that has none, such as a public DNS zone."
          },
          "subscription": {
            "type": "string",
            "description": "The subscription the resource is in."
          },
          "resource_group": {
            "type": "string",
            "description": "The resource group the resource is in. Azure needs it to address anything, so a finding without one produces a command nobody can run."
          },
          "arm_id": {
            "type": "string",
            "description": "The full Azure Resource Manager path. The only identifier unique across a tenant, and the handle a cleaner acts on; resource_id holds the bare name for display."
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subscription",
          "check",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "subscription": {
            "type": "string"
          }
        }
      }
    }
  }
}
